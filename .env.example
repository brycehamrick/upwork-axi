# Copy to your shell profile or session, or place this file in the working
# directory as .env (real environment variables always win). Never commit
# real values. The browser transport has no API key.

# Optional override of the browser-transport state directory (default
# ~/.upwork-axi). Mainly for tests and development.
# UPWORK_STATE_DIR=~/.upwork-axi

# Optional explicit path to the Chrome/Chromium binary used for the
# persistent Upwork session. Auto-detected when unset (see UPWORK_BROWSER).
# UPWORK_BROWSER_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional choice of which Chromium-family browser the daemon launches
# (UPWORK_BROWSER_BIN above always wins over this):
#   unset/auto - default: the Playwright-installed build when present (on
#              macOS its own "Google Chrome for Testing.app": real Chrome
#              engine in a separate app bundle, never touches your daily
#              Chrome), else installed Google Chrome.
#   chromium  - the Playwright-installed build only; fails loud if missing.
#              Install it with: npx playwright-core install chromium
#   chrome    - installed Google Chrome only. On macOS this shares the
#              Chrome.app bundle with your daily browser (one Dock icon;
#              clicking it focuses whichever instance is running) - opt in
#              only if you need the exact production browser.
# UPWORK_BROWSER=auto


